{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "packages/ts-config/**",
    ".prettierrc",
    "pnpm-workspace.yaml"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "cache": true
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": [],
      "cache": true
    },
    "typecheck:watch": {
      "persistent": true,
      "cache": false
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "outputs": [],
      "cache": true
    }
  }
}
