{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": true,
  "packages": {
    "packages/ts-config": {
      "package-name": "@lagetech/ts-config",
      "changelog-path": "CHANGELOG.md",
      "release-as": "0.1.0"
    },
    "packages/eslint-config": {
      "package-name": "@lagetech/eslint-config",
      "changelog-path": "CHANGELOG.md",
      "release-as": "0.1.0"
    }
  },
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Fixes"
    },
    {
      "type": "refactor",
      "section": "Refactoring"
    },
    {
      "type": "docs",
      "section": "Docs",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": true
    }
  ]
}
